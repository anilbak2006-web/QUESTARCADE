{
    "rewrites": [
        {
            "source": "/((?!api/|assets/|QUEST_IMAGES/|.*\\.(?:png|jpg|jpeg|gif|svg|webp|css|js|ico)).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/QUEST_IMAGES/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, s-maxage=604800"
                }
            ]
        },
        {
            "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|webp))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, s-maxage=604800"
                }
            ]
        }
    ]
}